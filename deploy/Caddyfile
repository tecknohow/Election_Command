# Caddy obtains and renews a Let's Encrypt certificate for {$DOMAIN} automatically.
# The app compresses its own responses (including the gzip SSE stream), so no `encode` here.
{$DOMAIN} {
	reverse_proxy election-command:8080 {
		# Stream server-sent events immediately instead of buffering.
		flush_interval -1
	}
	log {
		output stdout
		format console
	}
}

# Redirect a www. variant if you use one:
# www.{$DOMAIN} {
# 	redir https://{$DOMAIN}{uri} permanent
# }
