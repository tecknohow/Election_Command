# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.

# Admin sign-in secret (16+ chars). Unset = admin features and the simulator are disabled.
# Generate:  openssl rand -hex 24
ADMIN_TOKEN=

# --- Public deployment (docker compose --profile public) ---
# DOMAIN=elections.example.com
# TRUST_PROXY=1          # 1 = Caddy only; 2 = Cloudflare -> Caddy -> app
# HSTS=true              # once HTTPS works on the domain

# --- Optional ---
# EC_BIND=0.0.0.0        # expose the app port on all interfaces (LAN monitors without Caddy)
# SIM_ALLOWED=false      # remove the simulator entirely
# MAX_STREAMS=150
# MAX_STREAMS_PER_IP=16  # windows per household/IP (each monitor = 1 stream)
# API_RATE_PER_MIN=120
